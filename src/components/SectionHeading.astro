---
// Titre de section : label, titre, sous-titre optionnel.
const { eyebrow, title, subtitle, center = false } = Astro.props;
---

<div data-reveal class:list={['max-w-2xl', center && 'mx-auto text-center']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-4 text-3xl font-bold sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-base-content/70">{subtitle}</p>}
</div>
