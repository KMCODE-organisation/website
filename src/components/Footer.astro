---
import { defaultLocale, useTranslations } from '../i18n/index.js';

const t = useTranslations(Astro.currentLocale ?? defaultLocale);
const year = new Date().getFullYear();
---

<footer class="border-t border-base-300/60">
  <div class="mx-auto max-w-6xl px-4 py-8 text-center text-xs text-base-content/60 sm:px-6">
    © {year} KMCODE — {t('footer.rights')}
  </div>
</footer>
