---
import Logo from './Logo.astro';
import { contactEmail } from '../config.js';
import { defaultLocale, useTranslations } from '../i18n/index.js';

const t = useTranslations(Astro.currentLocale ?? defaultLocale);
const year = new Date().getFullYear();
---

<footer class="border-t border-base-300/60">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-10 text-sm text-base-content/60 sm:flex-row sm:px-6">
    <div class="flex flex-col items-center sm:items-start">
      <Logo height={26} />
      <p class="mt-2">{t('footer.tagline')}</p>
    </div>
    <a href={`mailto:${contactEmail}`} class="link link-hover">{contactEmail}</a>
    <p>© {year} KMCODE — {t('footer.rights')}</p>
  </div>
</footer>
