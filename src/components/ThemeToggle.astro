---
import { defaultLocale, useTranslations } from '../i18n/index.js';

const t = useTranslations(Astro.currentLocale ?? defaultLocale);
---

<button
  type="button"
  data-theme-toggle
  class="btn btn-circle btn-outline btn-sm border-base-content/30"
  aria-label={t('nav.toggleTheme')}
  title={t('nav.toggleTheme')}
>
  <!-- Soleil (thème sombre actif → passer en clair) -->
  <svg class="size-4 in-data-[theme=kmcode-light]:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <!-- Lune (thème clair actif → passer en sombre) -->
  <svg class="hidden size-4 in-data-[theme=kmcode-light]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  const THEMES = ['kmcode', 'kmcode-light'];
  const root = document.documentElement;

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = (root.dataset.theme ?? THEMES[0]) === THEMES[0] ? THEMES[1] : THEMES[0];
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  });
</script>
