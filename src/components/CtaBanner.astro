---
// Bandeau d'appel à l'action de fin de page.
import Icon from './Icon.astro';
import { contactEmail, phone } from '../config.js';
import { defaultLocale, useTranslations } from '../i18n/index.js';

const t = useTranslations(Astro.currentLocale ?? defaultLocale);
const { title = t('cta.title'), text = t('cta.text') } = Astro.props;
---

<section id="contact" class="scroll-mt-16 px-4 pb-24 sm:px-6">
  <div data-reveal class="cta-glow mx-auto max-w-6xl rounded-[2rem] border border-base-300 bg-base-200 px-6 py-16 text-center sm:px-16">
    <h2 class="mx-auto max-w-2xl text-3xl font-bold sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-base-content/70">{text}</p>
    <a href={`mailto:${contactEmail}`} class="btn btn-lg btn-primary mt-10 px-8">
      <Icon name="mail" class="size-5" />
      {t('cta.button')}
    </a>
    <p class="mt-4 text-base-content/70">
      {t('cta.phone')} <a href={phone.href} class="link font-semibold whitespace-nowrap">{phone.display}</a>
    </p>
    <p class="mt-4 flex items-center justify-center gap-2 text-sm text-base-content/60">
      <Icon name="check" class="size-4 text-accent" />
      {t('cta.reassurance')}
    </p>
  </div>
</section>

<style>
  /* Halo discret en dégradé (pas de filtre blur : sous Safari il déborde des coins arrondis). */
  .cta-glow {
    background-image:
      radial-gradient(ellipse 50% 70% at 50% 0%, color-mix(in oklab, var(--color-primary) 22%, transparent), transparent),
      radial-gradient(ellipse 35% 50% at 100% 100%, color-mix(in oklab, var(--color-accent) 12%, transparent), transparent);
  }
</style>
