---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { defaultLocale, useTranslations } from '../i18n/index.js';

const locale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(locale);
---

<header class="sticky top-0 z-40 border-b border-base-300/60 bg-base-100/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href={getRelativeLocaleUrl(locale)} class="text-lg font-bold tracking-wide" aria-label={t('nav.home')}>
      KMCODE
    </a>
    <div class="flex items-center gap-2">
      <LangSwitcher />
      <ThemeToggle />
    </div>
  </div>
</header>
