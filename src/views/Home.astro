---
import { defaultLocale, useTranslations } from '../i18n/index.js';

const t = useTranslations(Astro.currentLocale ?? defaultLocale);
const services = ['web', 'mobile', 'backend'];
---

<section class="mx-auto flex min-h-[calc(100dvh-4rem)] max-w-6xl flex-col justify-center px-4 py-24 sm:px-6">
  <p class="eyebrow">{t('home.eyebrow')}</p>
  <h1 class="mt-6 max-w-3xl text-4xl font-bold leading-tight sm:text-6xl">{t('home.title')}</h1>
  <p class="mt-6 max-w-2xl text-lg text-base-content/70">{t('home.subtitle')}</p>
  <div class="mt-10">
    <a href="#services" class="btn btn-primary btn-lg px-8">{t('home.cta')}</a>
  </div>
</section>

<section id="services" class="mx-auto max-w-6xl scroll-mt-16 px-4 py-24 sm:px-6">
  <p class="eyebrow">{t('home.services.eyebrow')}</p>
  <h2 class="mt-4 text-3xl font-bold sm:text-4xl">{t('home.services.title')}</h2>
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {
      services.map((key) => (
        <article class="card border border-base-300 bg-base-200">
          <div class="card-body">
            <h3 class="card-title text-xl">{t(`home.services.${key}.title`)}</h3>
            <p class="text-base-content/70">{t(`home.services.${key}.text`)}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
