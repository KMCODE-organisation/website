---
import Icon from '../components/Icon.astro';
import HeroVisual from '../components/HeroVisual.astro';
import PlanCards from '../components/PlanCards.astro';
import CtaBanner from '../components/CtaBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { care, formatPrice } from '../data/pricing.js';
import { contactEmail } from '../config.js';
import { defaultLocale, pathFor, useTranslations } from '../i18n/index.js';

const locale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(locale);
const offersUrl = pathFor('offers', locale);

const trust = [
  { key: 'local', icon: 'house' },
  { key: 'noSub', icon: 'key' },
  { key: 'offline', icon: 'wifi' },
  { key: 'owner', icon: 'shield' },
];
const benefits = [
  { key: 'comfort', icon: 'lightbulb' },
  { key: 'savings', icon: 'zap' },
  { key: 'security', icon: 'bell' },
];
const solutions = [
  { key: 'lighting', icon: 'lightbulb' },
  { key: 'climate', icon: 'thermometer' },
  { key: 'cameras', icon: 'camera' },
  { key: 'voice', icon: 'mic' },
  { key: 'tablet', icon: 'tablet' },
  { key: 'remote', icon: 'smartphone' },
];
const steps = ['audit', 'proposal', 'install', 'handover'];
const privacy = [
  { key: 'home', icon: 'house' },
  { key: 'cameras', icon: 'eyeOff' },
  { key: 'owner', icon: 'key' },
  { key: 'leave', icon: 'logOut' },
];
// Marques déjà intégrées en production (doc d'offre, section « Capacités »).
const brands = ['IKEA', 'Sonos', 'Bosch', 'LG', 'Xiaomi', 'Reolink', 'Sonoff', 'SwitchBot', 'Voltalis', 'iRobot Roomba'];
const faq = ['subscription', 'hardware', 'works', 'internet', 'alarm', 'ai'];
---

<!-- Hero -->
<section class="relative overflow-hidden">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-40 -left-40 size-[32rem] rounded-full bg-primary/25 blur-[120px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-40 bottom-0 size-[28rem] rounded-full bg-accent/15 blur-[120px]" aria-hidden="true"></div>

  <div class="relative mx-auto grid min-h-[calc(100dvh-4rem)] max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="eyebrow">{t('hero.eyebrow')}</p>
      <h1 class="mt-6 text-4xl leading-[1.1] font-bold sm:text-6xl">
        {t('hero.titleStart')} <span class="text-gradient">{t('hero.titleHighlight')}</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-base-content/70">{t('hero.subtitle')}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={offersUrl} class="btn btn-lg btn-primary px-8">
          {t('hero.ctaPrimary')}
          <Icon name="arrowRight" class="size-5" />
        </a>
        <a href={`mailto:${contactEmail}`} class="btn btn-lg btn-outline border-base-content/20 px-8">{t('hero.ctaSecondary')}</a>
      </div>
      <p class="mt-4 flex items-center gap-2 text-sm text-base-content/60">
        <Icon name="check" class="size-4 text-accent" />
        {t('hero.reassurance')}
      </p>
    </div>
    <HeroVisual />
  </div>
</section>

<!-- Engagements -->
<section class="border-y border-base-300 bg-base-200/50">
  <ul class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-4 py-8 sm:px-6 lg:grid-cols-4">
    {
      trust.map(({ key, icon }) => (
        <li class="flex items-center gap-3 text-sm font-medium">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent/15 text-accent">
            <Icon name={icon} class="size-5" />
          </span>
          {t(`trust.${key}`)}
        </li>
      ))
    }
  </ul>
</section>

<!-- Bénéfices -->
<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <SectionHeading eyebrow={t('problem.eyebrow')} title={t('problem.title')} />
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {
      benefits.map(({ key, icon }) => (
        <article data-reveal class="rounded-box border border-base-300 p-8">
          <Icon name={icon} class="size-8 text-primary" />
          <h3 class="mt-6 text-xl font-bold">{t(`problem.items.${key}.title`)}</h3>
          <p class="mt-3 text-base-content/70">{t(`problem.items.${key}.text`)}</p>
        </article>
      ))
    }
  </div>
</section>

<!-- Solutions -->
<section id="solutions" class="scroll-mt-16 bg-base-200/50 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading eyebrow={t('solutions.eyebrow')} title={t('solutions.title')} subtitle={t('solutions.subtitle')} />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        solutions.map(({ key, icon }) => (
          <article
            data-reveal
            class="group card border border-base-300 bg-base-100 transition duration-300 hover:-translate-y-1 hover:border-primary/60"
          >
            <div class="card-body gap-4 p-8">
              <span class="grid size-12 place-items-center rounded-2xl bg-primary/10 text-primary transition group-hover:bg-primary group-hover:text-primary-content">
                <Icon name={icon} class="size-6" />
              </span>
              <h3 class="card-title text-lg">{t(`solutions.items.${key}.title`)}</h3>
              <p class="text-base-content/70">{t(`solutions.items.${key}.text`)}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Offres -->
<section id="offers" class="mx-auto max-w-6xl scroll-mt-16 px-4 py-24 sm:px-6">
  <SectionHeading eyebrow={t('plans.eyebrow')} title={t('plans.title')} subtitle={t('plans.subtitle')} />
  <div class="mt-12">
    <PlanCards />
  </div>
  <div data-reveal class="mt-10 flex flex-col items-center justify-between gap-4 rounded-box border border-base-300 p-6 sm:flex-row">
    <p class="flex items-center gap-3">
      <Icon name="refresh" class="size-6 shrink-0 text-accent" />
      <span>
        <strong>{t('offers.careTitle')}</strong> — {t('common.from')}
        {formatPrice(care.serenity, locale)}{t('common.perMonth')}, {t('offers.careValues.none').toLowerCase()}
      </span>
    </p>
    <a href={offersUrl} class="btn btn-outline border-base-content/20">
      {t('plans.seeAll')}
      <Icon name="arrowRight" class="size-4" />
    </a>
  </div>
</section>

<!-- Méthode -->
<section id="method" class="scroll-mt-16 bg-base-200/50 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading eyebrow={t('method.eyebrow')} title={t('method.title')} />
    <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((key, i) => (
          <li data-reveal class="relative rounded-box border border-base-300 bg-base-100 p-8">
            <span class="text-gradient text-5xl font-bold">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-lg font-bold">{t(`method.steps.${key}.title`)}</h3>
            <p class="mt-3 text-base-content/70">{t(`method.steps.${key}.text`)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- Vos données -->
<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <SectionHeading eyebrow={t('privacy.eyebrow')} title={t('privacy.title')} subtitle={t('privacy.text')} />
  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      privacy.map(({ key, icon }) => (
        <article data-reveal class="rounded-box border border-base-300 p-6">
          <span class="grid size-11 place-items-center rounded-full bg-accent/15 text-accent">
            <Icon name={icon} class="size-5" />
          </span>
          <h3 class="mt-5 font-bold">{t(`privacy.items.${key}.title`)}</h3>
          <p class="mt-2 text-sm text-base-content/70">{t(`privacy.items.${key}.text`)}</p>
        </article>
      ))
    }
  </div>
</section>

<!-- Compatibilité -->
<section class="border-y border-base-300 bg-base-200/50 py-20">
  <div data-reveal class="mx-auto max-w-4xl px-4 text-center sm:px-6">
    <p class="eyebrow">{t('brands.eyebrow')}</p>
    <h2 class="mt-4 text-2xl font-bold sm:text-3xl">{t('brands.title')}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-base-content/70">{t('brands.text')}</p>
    <ul class="mt-10 flex flex-wrap justify-center gap-3">
      {brands.map((name) => <li class="badge badge-lg badge-outline border-base-content/20 px-4 py-4 font-medium">{name}</li>)}
    </ul>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="mx-auto max-w-3xl scroll-mt-16 px-4 py-24 sm:px-6">
  <SectionHeading eyebrow={t('faq.eyebrow')} title={t('faq.title')} center />
  <div class="mt-12 space-y-3">
    {
      faq.map((key, i) => (
        <details class="collapse-plus collapse rounded-box border border-base-300 bg-base-200/50" name="faq" open={i === 0}>
          <summary class="collapse-title font-semibold">{t(`faq.items.${key}.q`)}</summary>
          <div class="collapse-content text-base-content/70">
            <p>{t(`faq.items.${key}.a`)}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<CtaBanner />

<style>
  /* Quadrillage discret, estompé vers les bords. */
  .hero-grid {
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--color-base-content) 6%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-base-content) 6%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }
</style>
